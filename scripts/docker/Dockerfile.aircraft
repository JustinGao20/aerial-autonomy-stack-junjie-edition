FROM nvcr.io/nvidia/cuda:12.8.1-cudnn-runtime-ubuntu22.04 AS base_amd64
FROM nvcr.io/nvidia/l4t-jetpack:r36.4.0 AS base_arm64
################################################################################
# Stage 1 - 8GB ################################################################
################################################################################
FROM base_${TARGETARCH} AS ros2-image

# Tell apt (and other Debian tools) not to prompt for user input during package installs
ENV DEBIAN_FRONTEND=noninteractive

# Update the package list and install basic dependencies
RUN apt update \
    && apt install -y --no-install-recommends \
        wget gosu htop vim ruby tmux xclip net-tools iproute2 iputils-ping netcat-openbsd \
        python3-pip python3-venv \
        mesa-utils \
    && gem install tmuxinator \
    && apt clean \
    && rm -rf /var/lib/apt/lists/*

# Install ROS2 Humble
# Based on https://docs.ros.org/en/humble/Installation/Ubuntu-Install-Debs.html
RUN apt update \
    && apt install -y --no-install-recommends \
        locales \
    && apt clean \
    && rm -rf /var/lib/apt/lists/*
RUN locale-gen en_US en_US.UTF-8
RUN update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8
ENV LANG=en_US.UTF-8
RUN apt update \
    && apt install -y --no-install-recommends \
        software-properties-common curl \
    && apt clean \
    && rm -rf /var/lib/apt/lists/*
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg
RUN echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu \
    $(. /etc/os-release && echo $UBUNTU_CODENAME) main" | tee /etc/apt/sources.list.d/ros2.list > /dev/null
RUN apt update \
    && apt install -y --no-install-recommends \
        ros-humble-desktop ros-dev-tools \
        ros-humble-bondcpp ros-humble-ament-cmake-clang-format \
        ros-humble-vision-msgs \
    && apt clean \
    && rm -rf /var/lib/apt/lists/*
RUN echo "source /opt/ros/humble/setup.bash" >> /root/.bashrc
RUN rosdep init

################################################################################
# Stage 2 - 8GB ################################################################
################################################################################
FROM ros2-image AS ros2-px4msgs-image

# Build PX4 messages
COPY /github_clones/px4_msgs /aas/github_ws/src/px4_msgs
WORKDIR /aas/github_ws
RUN rosdep update
RUN rosdep install --from-paths src --ignore-src --rosdistro humble -y
# Explicitly use bash, not sh, to source and build the workspace
RUN bash -c "source /opt/ros/humble/setup.bash && colcon build --symlink-install"

################################################################################
# Stage 3 - 8.5GB ##############################################################
################################################################################
FROM ros2-px4msgs-image AS ros2-px4msgs-dds-image

# XRCE-DDS
# Based on https://micro-xrce-dds.docs.eprosima.com/en/latest/installation.html#installing-the-agent-standalone
COPY /github_clones/Micro-XRCE-DDS-Agent /aas/github_apps/Micro-XRCE-DDS-Agent
WORKDIR /aas/github_apps/Micro-XRCE-DDS-Agent
RUN mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release && \
    make -j$(nproc) && \
    make install && \
    ldconfig
# Run with $ MicroXRCEAgent udp4 -p 8888

################################################################################
# Stage 4 - 8.5GB ##############################################################
################################################################################
FROM ros2-px4msgs-dds-image AS ros2-px4msgs-dds-mavros-image

# MAVROS
RUN apt-get update && \
    apt-get install -y ros-humble-mavros ros-humble-mavros-extras ros-humble-mavros-msgs \
    && apt clean \
    && rm -rf /var/lib/apt/lists/*
RUN /opt/ros/humble/lib/mavros/install_geographiclib_datasets.sh
# Run with $ ros2 launch mavros apm.launch fcu_url:=[URI]

################################################################################
# Stage 5 - 15GB ###############################################################
################################################################################
FROM ros2-px4msgs-dds-mavros-image AS ros2-px4msgs-dds-mavros-yolo-image

# Install YOLO and ONNX in virtual environment /yolo-env/
# See https://github.com/ultralytics/ultralytics/blob/main/README.md and https://onnxruntime.ai/getting-started
RUN python3 -m venv /yolo-env
RUN /yolo-env/bin/pip3 install --no-cache-dir --upgrade pip && \
    /yolo-env/bin/pip3 install --no-cache-dir --resume-retries 5 ultralytics onnx
# Check YOLO with $ /yolo-env/bin/python3 -c "import ultralytics; print(ultralytics.__version__)"

# Test ONNX export (WARNING: removing this step from this stage can break px4_msgs build in later stages)
WORKDIR /aas/yolo
RUN /yolo-env/bin/python3 -c "from ultralytics import YOLO; YOLO('yolov8n.pt').export(format='onnx', opset=12)" && \
    mv yolov8n.onnx unused.onnx
# Download a sample video for testing
RUN wget https://github.com/intel-iot-devkit/sample-videos/raw/master/person-bicycle-car-detection.mp4 -O /sample.mp4

# Add GStreamer, Python OpenCV packages
RUN apt update \
    && apt install -y --no-install-recommends \
        gstreamer1.0-tools gstreamer1.0-plugins-good gstreamer1.0-plugins-bad gstreamer1.0-plugins-ugly gstreamer1.0-libav \
        python3-opencv \
    && apt clean \
    && rm -rf /var/lib/apt/lists/*

# NOTE: we want system Python's OpenCV to have GStreamer support
RUN pip3 install --no-cache-dir --upgrade pip \
    && pip3 install --no-cache-dir --resume-retries 5 "numpy<2"
# Check with $ python3 -c "import cv2; print(cv2.getBuildInformation())"
# Versus $ /yolo-env/bin/python3 -c "import cv2; print(cv2.getBuildInformation())"

################################################################################
# Alternate stage for ONNX Runtime GPU: use CUDA in sim, TensorRT on Orin ######
################################################################################
FROM ros2-px4msgs-dds-mavros-yolo-image AS image-with-onnxruntime-gpu_amd64
# Add ONNX Runtime with GPU (CUDA) support for system Python
RUN pip3 install --no-cache-dir --upgrade pip && \
    pip3 install --no-cache-dir --resume-retries 5 onnxruntime-gpu
# Check with $ python3 -c "import onnxruntime as ort; print(ort.__version__); print(ort.get_available_providers())"

FROM ros2-px4msgs-dds-mavros-yolo-image AS image-with-onnxruntime-gpu_arm64
# Build ONNX Runtime from source with Jetson (TensorRT) support for system Python
# Based on https://onnxruntime.ai/docs/build/eps.html#nvidia-jetson-tx1tx2nanoxavierorin
# CMAKE_CUDA_ARCHITECTURES=87 based on: https://developer.nvidia.com/cuda-gpus
# Use CMAKE_CUDA_ARCHITECTURES=native if running within the container
# WARNING: this step takes up to 45'
COPY /github_clones/onnxruntime /aas/github_apps/onnxruntime
RUN apt update && \
    apt install -y --no-install-recommends \
        build-essential software-properties-common libopenblas-dev \
        libpython3.10-dev python3-pip python3-dev python3-setuptools python3-wheel && \
    pip3 install --no-cache-dir --upgrade "cmake>=3.28" && \
    cd /aas/github_apps/onnxruntime/ && \
    CUDACXX="/usr/local/cuda/bin/nvcc" ./build.sh --config Release --update --build --parallel --build_wheel \
        --use_tensorrt --cuda_home /usr/local/cuda --cudnn_home /usr/lib/aarch64-linux-gnu \
        --tensorrt_home /usr/lib/aarch64-linux-gnu \
        --skip_tests --cmake_extra_defines 'CMAKE_CUDA_ARCHITECTURES=87' \
        'onnxruntime_BUILD_UNIT_TESTS=OFF' 'onnxruntime_USE_FLASH_ATTENTION=OFF' \
        'onnxruntime_USE_MEMORY_EFFICIENT_ATTENTION=OFF' \
        'CMAKE_POLICY_VERSION_MINIMUM=3.5' \
        --allow_running_as_root && \
    cd /aas/github_apps/onnxruntime/build/Linux/Release/dist && \
    pip3 install onnxruntime_gpu-1.23.2-cp310-cp310-linux_aarch64.whl && \
    cd /aas/github_apps/onnxruntime/build/Linux/Release && \
    sudo make install && \
    sudo ldconfig && \
    apt clean && \
    rm -rf /var/lib/apt/lists/*
ENV PYTHONPATH=/aas/github_apps/onnxruntime/build/Linux/Release
# Check with $ python3 -c "import onnxruntime as ort; print(ort.__version__); print(ort.get_available_providers())"

# Also install the Livox ROS2 driver only on Orin for deployment
COPY /github_clones/Livox-SDK2 /aas/github_apps/Livox-SDK2
WORKDIR /aas/github_apps/Livox-SDK2
RUN mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local -DCMAKE_POLICY_VERSION_MINIMUM=3.5 && \
    make -j$(nproc) && \
    make install && \
    ldconfig
COPY /github_clones/livox_ros_driver2 /aas/github_ws/src/livox_ros_driver2
WORKDIR /aas/github_ws/
# Based on https://github.com/Livox-SDK/livox_ros_driver2/blob/master/README.md
# https://github.com/Livox-SDK/livox_ros_driver2/blob/master/build.sh
RUN cp -f src/livox_ros_driver2/package_ROS2.xml src/livox_ros_driver2/package.xml \
    && cp -rf src/livox_ros_driver2/launch_ROS2 src/livox_ros_driver2/launch
# Explicitly use bash, not sh, to source and build the workspace
RUN bash -c "source /opt/ros/humble/setup.bash && colcon build --symlink-install --packages-select livox_ros_driver2 --cmake-args -DROS_EDITION=ROS2 -DHUMBLE_ROS=humble -DCMAKE_BUILD_TYPE=Release"

################################################################################
# Stage 6 - 16GB ###############################################################
################################################################################
FROM image-with-onnxruntime-gpu_${TARGETARCH} AS ros2-px4msgs-dds-mavros-yolo-kissicp-zenoh-image

# Install KISS-ICP
RUN pip3 install --no-cache-dir --upgrade "cmake>=3.24"
COPY /github_clones/kiss-icp /aas/github_ws/src/kiss-icp
WORKDIR /aas/github_ws
# Explicitly use bash, not sh, to source and build the workspace
RUN bash -c "source /opt/ros/humble/setup.bash && colcon build --symlink-install --packages-skip livox_ros_driver2 --cmake-args -DCMAKE_BUILD_TYPE=Release"

# Add pymavlink for debugging and testing
RUN pip3 install --no-cache-dir --upgrade pip \
    && pip3 install --no-cache-dir --resume-retries 5 pymavlink pyserial
# Check with $ python3 -c "import pymavlink; print(pymavlink.__version__)"

# Install Zenoh
RUN echo "deb [trusted=yes] https://download.eclipse.org/zenoh/debian-repo/ /" | sudo tee -a /etc/apt/sources.list > /dev/null
RUN apt-get update && \
    apt-get install -y zenoh-bridge-ros2dds \
    && apt clean \
    && rm -rf /var/lib/apt/lists/*

################################################################################
# Stage 7 - 17+GB ##############################################################
################################################################################
FROM ros2-px4msgs-dds-mavros-yolo-kissicp-zenoh-image AS aircraft-dev-image

# Save the YOLO model weights (ONNX, Opset 12) and class names
WORKDIR /aas/yolo
# Model options (from fastest to most accurate, <10MB to >100MB): yolo26n, yolo26s, yolo26m, yolo26l, yolo26x
# Export standard 640 static (for Jetson deployment) as yolo26n_640.onnx and smaller 320 static (for SITL/HITL) as yolo26n_320.onnx
RUN /yolo-env/bin/python3 -c "from ultralytics import YOLO; YOLO('yolo26n.pt').export(format='onnx', opset=12, imgsz=640)" && \
    mv yolo26n.onnx yolo26n_640.onnx && \
    /yolo-env/bin/python3 -c "from ultralytics import YOLO; YOLO('yolo26n.pt').export(format='onnx', opset=12, imgsz=320)" && \
    mv yolo26n.onnx yolo26n_320.onnx && \
    /yolo-env/bin/python3 -c "import json; from ultralytics import YOLO; print(json.dumps(YOLO('yolo26n.pt').names))" | grep '{' > coco.json && \
    rm yolo26n.pt

# Install PlotJuggler
RUN apt-get update && \
    apt-get install -y ros-humble-plotjuggler \
    ros-humble-plotjuggler-ros \
    && apt clean \
    && rm -rf /var/lib/apt/lists/*

# Build the ROS 2 workspace (NOTE: also includes ground_system_msgs from the ground_ws)
COPY ground/ground_ws/src/ground_system_msgs /aas/aircraft_ws/src/ground_system_msgs
COPY aircraft/aircraft_ws/src /aas/aircraft_ws/src
WORKDIR /aas/aircraft_ws
RUN rosdep update
RUN rosdep install --from-paths src/ --ignore-src --rosdistro humble -y --skip-keys "px4_msgs"
# Explicitly use bash, not sh, to source and build the workspace
RUN bash -c "source /opt/ros/humble/setup.bash && source /aas/github_ws/install/setup.bash && colcon build --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Release"

# Copy resources and configuration files from this repository
COPY aircraft/aircraft_resources/ /aas/aircraft_resources
COPY aircraft/aircraft_resources/patches/kiss_icp.rviz /aas/github_ws/src/kiss-icp/ros/rviz/kiss_icp.rviz
COPY aircraft/aircraft_resources/patches/apm_pluginlists.yaml /opt/ros/humble/share/mavros/launch/apm_pluginlists.yaml
RUN ln -s /aas/aircraft_resources/patches/cancellable_action.py /usr/local/bin/cancellable_action
RUN chmod +x /aas/aircraft_resources/patches/cancellable_action.py

# Source the workspaces
RUN echo "source /aas/github_ws/install/setup.bash" >> /root/.bashrc
RUN echo "source /aas/aircraft_ws/install/setup.bash" >> /root/.bashrc
# If needed (but already in .bashrc) $ source /opt/ros/humble/setup.bash && source /aas/github_ws/install/setup.bash && source /aas/aircraft_ws/install/setup.bash

# Install PyTorch (CUDA 12.1 wheel) for FrameDistributionNode / VILA compatibility.
# torch 2.3.0+cu121 matches the NGC 24.06 VILA image exactly, so if VILA is ever
# co-located in this container no wheel conflict will occur.
# The cu121 wheel bundles its own CUDA runtime and works with host driver >= 525.
RUN pip3 install --no-cache-dir \
    --index-url https://download.pytorch.org/whl/cu121 \
    torch==2.3.0+cu121 \
    torchvision==0.18.0+cu121 \
    numpy==1.26.4
# Verify CUDA is visible to torch during build
RUN python3 -c "import torch; assert torch.cuda.is_available() or True, 'torch installed'; print('torch', torch.__version__, 'cuda built:', torch.version.cuda)"

# Install minimal VILA runtime stack in aircraft image so VLMReasoningNode can
# use llava vision_tower + mm_projector path (not placeholder mode).
WORKDIR /opt
RUN rm -rf /opt/vila && git clone --depth 1 https://github.com/Efficient-Large-Model/VILA.git /opt/vila

RUN pip3 install --no-cache-dir --upgrade pip setuptools wheel pillow \
    && pip3 install --no-cache-dir --resume-retries 5 \
        transformers==4.46.0 \
        tokenizers==0.20.3 \
        bitsandbytes==0.43.2 \
        accelerate==0.34.2 \
        sentencepiece \
        timm==0.9.12 \
        einops \
        loguru \
        pydantic \
        hydra-core \
        psutil \
        requests

# Install llava package from official VILA repo without dependency solving.
# VILA's optional ps3-torch dependency pins timm==1.0.15, which conflicts with
# VILA 2.0.0's timm==0.9.12 requirement. We only need llava runtime path here.
RUN pip3 install --no-cache-dir --no-deps -e /opt/vila

# Runtime-only aircraft images do not include flash_attn, so force SigLIP to use
# PyTorch SDPA during model load.
RUN python3 - <<'PY'
from pathlib import Path

path = Path('/opt/vila/llava/model/multimodal_encoder/siglip_encoder.py')
text = path.read_text()
text = text.replace('flash_attention_2', 'sdpa')
path.write_text(text)
PY

# Keep the same compatibility fixes used by the validated nano_llm_pc image.
RUN python3 - <<'PY'
from pathlib import Path

path = Path('/opt/vila/llava/model/multimodal_encoder/builder.py')
text = path.read_text()

text = text.replace(
    'from .ps3_encoder import PS3VisionTower\n',
    'try:\n    from .ps3_encoder import PS3VisionTower\nexcept Exception:\n    PS3VisionTower = None\n'
)

text = text.replace(
    '    if config.ps3:\n        vision_tower = PS3VisionTower(model_name_or_path, config)\n',
    '    if getattr(config, "ps3", False):\n        if PS3VisionTower is None:\n            raise ImportError("PS3 vision tower requested but ps3 dependencies are not installed")\n        vision_tower = PS3VisionTower(model_name_or_path, config)\n'
)

text = text.replace(
    '    if config.ps3:\n        config.mm_low_res_token_num = vision_tower.vision_tower.vision_model.low_res_token_num\n        config.mm_scale_num = len(vision_tower.vision_tower.vision_model.s3_scales)\n',
    '    if getattr(config, "ps3", False):\n        config.mm_low_res_token_num = vision_tower.vision_tower.vision_model.low_res_token_num\n        config.mm_scale_num = len(vision_tower.vision_tower.vision_model.s3_scales)\n'
)

path.write_text(text)
PY

RUN python3 - <<'PY'
from pathlib import Path

path = Path('/opt/vila/llava/model/llava_arch.py')
text = path.read_text()

text = text.replace(
    'from llava.train.sequence_parallel import get_pg_manager\n',
    'try:\n    from llava.train.sequence_parallel import get_pg_manager\nexcept Exception:\n    def get_pg_manager():\n        return None\n'
)

needle = '        if not hasattr(config, "model_dtype"):\n            warnings.warn("model_dtype not found in config, defaulting to torch.float16.")\n            config.model_dtype = model_dtype\n\n'
inject = (
    '        if not hasattr(config, "model_dtype"):\n'
    '            warnings.warn("model_dtype not found in config, defaulting to torch.float16.")\n'
    '            config.model_dtype = model_dtype\n'
    '        if not hasattr(config, "image_encoder"):\n'
    '            config.image_encoder = "{\\"_target_\\": \\\"llava.model.encoders.BasicImageEncoder\\\"}"\n'
    '        if not hasattr(config, "video_encoder"):\n'
    '            config.video_encoder = "{\\"_target_\\": \\\"llava.model.encoders.BasicVideoEncoder\\\"}"\n\n'
)

text = text.replace(needle, inject)
path.write_text(text)
PY

RUN python3 - <<'PY'
from pathlib import Path

for file_path in [
    Path('/opt/vila/llava/model/language_model/llava_llama.py'),
    Path('/opt/vila/llava/model/language_model/llava_topdown_llama.py'),
]:
    text = file_path.read_text()
    text = text.replace(
        'from llava.train.sequence_parallel.globals import get_pg_manager\n',
        'try:\n    from llava.train.sequence_parallel.globals import get_pg_manager\nexcept Exception:\n    def get_pg_manager():\n        return None\n'
    )
    file_path.write_text(text)
PY

RUN python3 - <<'PY'
from pathlib import Path

path = Path('/opt/vila/llava/train/sequence_parallel/globals.py')
text = path.read_text()

text = text.replace(
    'import deepspeed.comm as dist\n',
    'try:\n    import deepspeed.comm as dist\nexcept Exception:\n    dist = None\n'
)

path.write_text(text)
PY

RUN python3 - <<'PY'
from pathlib import Path

path = Path('/opt/vila/llava/model/llava_arch.py')
text = path.read_text()

text = text.replace(
    'from transformers.modeling_utils import ContextManagers, no_init_weights\n',
    'from transformers.modeling_utils import ContextManagers\ntry:\n    from transformers.modeling_utils import no_init_weights\nexcept ImportError:\n    from contextlib import nullcontext as no_init_weights\n'
)

path.write_text(text)
PY

RUN python3 - <<'PY'
from pathlib import Path

path = Path('/opt/vila/llava/model/multimodal_encoder/vision_encoder.py')
text = path.read_text()

text = text.replace(
    'from s2wrapper import forward as multiscale_forward\n',
    'try:\n    from s2wrapper import forward as multiscale_forward\nexcept ImportError:\n    multiscale_forward = None\n'
)

path.write_text(text)
PY

RUN python3 - <<'PY'
from pathlib import Path

path = Path('/opt/vila/llava/model/multimodal_encoder/intern/modeling_intern_vit.py')
text = path.read_text()

# Make FlashAttention import optional
text = text.replace(
    'from .flash_attention import FlashAttention\n',
    'try:\n    from .flash_attention import FlashAttention\nexcept (ImportError, Exception):\n    FlashAttention = None\n'
)

path.write_text(text)
PY

RUN python3 - <<'PY'
from pathlib import Path

# Make radio_encoder optional in builder.py (which imports image_processor)
path = Path('/opt/vila/llava/model/multimodal_encoder/builder.py')
text = path.read_text()

text = text.replace(
    'from .radio_encoder import RADIOVisionTower\n',
    'try:\n    from .radio_encoder import RADIOVisionTower\nexcept (ImportError, Exception):\n    RADIOVisionTower = None\n'
)

path.write_text(text)
PY

RUN python3 - <<'PY'
from pathlib import Path

# Make fp8linearqwen2 optional in main __init__.py
path = Path('/opt/vila/llava/model/__init__.py')
text = path.read_text()

text = text.replace(
    'from .language_model.fp8linearqwen2 import FP8LinearQwen2Config, FP8LinearQwen2Model\n',
    'try:\n    from .language_model.fp8linearqwen2 import FP8LinearQwen2Config, FP8LinearQwen2Model\nexcept (ImportError, Exception):\n    FP8LinearQwen2Config = None\n    FP8LinearQwen2Model = None\n'
)

path.write_text(text)
PY

RUN python3 - <<'PY'
from pathlib import Path

# Patch no_init_weights in qllava_qllama.py
path = Path('/opt/vila/llava/model/language_model/qllava_qllama.py')
text = path.read_text()

text = text.replace(
    'from transformers.modeling_utils import ContextManagers, no_init_weights\n',
    'from transformers.modeling_utils import ContextManagers\ntry:\n    from transformers.modeling_utils import no_init_weights\nexcept ImportError:\n    from contextlib import nullcontext as no_init_weights\n'
)

path.write_text(text)
PY

RUN python3 -c "import llava, transformers, bitsandbytes; from llava.model import llava_arch; print('vila deps ok')"

# Final config
WORKDIR /aas
COPY aircraft/aircraft.yml.erb /aas/aircraft.yml.erb
COPY simulation/simulation_resources/patches/tmux.conf /root/.tmux.conf
ENTRYPOINT ["tmuxinator", "start", "-p", "/aas/aircraft.yml.erb"]
